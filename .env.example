# copy to .env and fill in. .env is git-excluded, never commit real keys.

# supabase postgres. use the "connection string" from project settings > database.
# for scripts, the direct/session connection works. sslmode=require is fine.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# supabase api, from project settings > api. the anon key is browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# personal access token from https://supabase.com/dashboard/account/tokens
# only needed for local db tooling (migrate/seed/diagram) when the network blocks the
# postgres port, we run sql over the management api on 443 instead. the app itself does
# not use this.
SUPABASE_ACCESS_TOKEN=

# claude, for intake extraction, report reasoning, post-call extraction
ANTHROPIC_API_KEY=

# resend, emailed report. sandbox sender needs no dns.
RESEND_API_KEY=
REPORT_FROM_EMAIL=onboarding@resend.dev

# voice, filled in once the vapi + twilio accounts exist. until then the call
# provider runs in local simulated mode.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
BROKER_PHONE_NUMBER=

# voice tuning (optional, sensible fast defaults are baked in: haiku + cartesia sonic).
# override only if you want a different model or voice.
VOICE_LLM_PROVIDER=
VOICE_LLM_MODEL=
VOICE_PROVIDER=
VOICE_ID=

# demo: force-now a single call job from the status page, bypass the schedule
DEMO_MODE=false
